{
	"$schema": "https://schemas.wp.org/trunk/theme.json",
	"version": 2,
	"settings": {
		"appearanceTools": true,
		"useRootPaddingAwareAlignments": true,
		"layout": {
			"contentSize": "760px",
			"wideSize": "1240px"
		},
		"color": {
			"defaultPalette": false,
			"custom": false,
			"palette": [
				{ "slug": "ink", "name": "Ink", "color": "#12150F" },
				{ "slug": "ink-soft", "name": "Ink soft", "color": "#2B3028" },
				{ "slug": "muted", "name": "Muted", "color": "#5C6158" },
				{ "slug": "paper", "name": "Paper", "color": "#F6F3EC" },
				{ "slug": "paper-deep", "name": "Paper deep", "color": "#EDE8DC" },
				{ "slug": "accent", "name": "Pine", "color": "#1E4A3A" },
				{ "slug": "warm", "name": "Sienna", "color": "#B9814A" },
				{ "slug": "white", "name": "White", "color": "#FFFFFF" }
			],
			"gradients": [
				{
					"slug": "paper-fade",
					"name": "Paper fade",
					"gradient": "linear-gradient(135deg, #F6F3EC 0%, #E2DBCB 100%)"
				},
				{
					"slug": "pine-fade",
					"name": "Pine fade",
					"gradient": "linear-gradient(135deg, #1E4A3A 0%, #12150F 100%)"
				}
			]
		},
		"typography": {
			"fluid": true,
			"fontFamilies": [
				{
					"slug": "display",
					"name": "Instrument Serif",
					"fontFamily": "\"Instrument Serif\", Georgia, serif"
				},
				{
					"slug": "sans",
					"name": "Inter",
					"fontFamily": "\"Inter\", -apple-system, BlinkMacSystemFont, \"Segoe UI\", sans-serif"
				}
			],
			"fontSizes": [
				{ "slug": "small", "name": "Small", "size": "0.8125rem" },
				{ "slug": "base", "name": "Body", "size": "1.0625rem" },
				{ "slug": "lead", "name": "Lead", "size": "1.25rem" },
				{ "slug": "h3", "name": "Heading 3", "size": "1.75rem" },
				{
					"slug": "h2",
					"name": "Heading 2",
					"size": "3.1rem",
					"fluid": { "min": "2rem", "max": "3.1rem" }
				},
				{
					"slug": "h1",
					"name": "Heading 1",
					"size": "4.6rem",
					"fluid": { "min": "2.8rem", "max": "4.6rem" }
				},
				{
					"slug": "display",
					"name": "Display",
					"size": "6.6rem",
					"fluid": { "min": "3.2rem", "max": "6.6rem" }
				}
			]
		},
		"spacing": {
			"units": ["px", "rem", "em", "vw", "%"],
			"spacingSizes": [
				{ "slug": "20", "name": "Tight", "size": "0.75rem" },
				{ "slug": "30", "name": "Base", "size": "1.25rem" },
				{ "slug": "40", "name": "Room", "size": "2rem" },
				{ "slug": "50", "name": "Section", "size": "3.5rem" },
				{ "slug": "60", "name": "Wide", "size": "5.5rem" }
			]
		}
	}
}
